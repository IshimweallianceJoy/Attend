
@using Application.DTOs
@using Application.Services.AttendenceServices
@using Application.Services.ClassServices
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize] 

@inject IClassService ClassService


<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (attend == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Class details could not be found.</MudText>
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>
            <MudForm @ref="_form">
                <MudGrid>
                 
                    <MudItem xs="12">
                        <MudSelect Adornment="Adornment.End" Immediate="true" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.LibraryBooks" Label="Class"
                                   @bind-value="attend.ClasssId">

                        
                            <MudSelectItem Value="0">--Select Class--</MudSelectItem>
                            @if (classs != null)
                            {
                                foreach (var c in classs)
                                {
                                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>


                </MudGrid>
                <MudButton OnClick="Save" Disabled="@isLoading" Color="Color.Primary" Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit">EDIT</MudButton>
                           
            </MudForm>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Inject]
    public IAttendenceService AttendenceService { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public int Id { get; set; }

    private bool isLoading = true;
    private GetAttendenceDTO? attend;
    private MudForm? _form;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (Id > 0)
        {
            attend = await AttendenceService.GetAttendenceByIdAsync(Id);
        }

        isLoading = false;
    }
    private readonly DialogOptions _closeButton = new() { CloseButton = true };
    private List<GetClassDTO> classs = new();
    

    protected override async Task OnInitializedAsync()
    {


        var c = await ClassService.GetClasssesAsync();
        if (classs != null)
        {
            classs = c;
            StateHasChanged();
        }

   
    }

    private async Task Save()
    {
        if (_form == null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid || attend == null)
            return;

        await AttendenceService.UpdateAttendenceAsync(new UpdateAttendenceDTO
        {
            Id = attend.Id,
            ClasssId = attend.ClasssId,
            
            
        });

        MudDialog?.Close(DialogResult.Ok(attend));
        StateHasChanged();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }
}