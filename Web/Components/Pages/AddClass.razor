@using Application.Services.ClassServices
@using Domain.Entities
@using Application.DTOs
@using Application.Services.FaculityServices
@using Application.Services.EducationLevelServices

@rendermode InteractiveServer
@inject NavigationManager navigation
@inject IClassService ClassService
@inject IFaculityService FaculityService
@inject IEducationLevelService EducationLevelService
@page "/class/add"
<MudDialog>
    <TitleContent>Add Class</TitleContent>
    <DialogContent>
        <EditForm Model="classs" OnValidSubmit="SaveClassAsync">
           <MudGrid>
            <MudItem xs="12">
                <MudTextField 
                 Adornment="Adornment.End"
                 Label="Class Name"
                Immediate="true"
                 AdornmentIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                @bind-Value="classs.Name"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Placeholder="Ex: S1 A">
                </MudTextField>
            </MudItem>
            
           
            <MudItem xs="12">
                <MudSelect 
                    Adornment="Adornment.End"
                    Immediate="true"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    AdornmentIcon="@Icons.Material.Filled.LibraryBooks"
                    Label="Faculty"
                    @bind-value="classs.FaculityId">
                    <MudSelectItem Value="0">--Select faculty--</MudSelectItem>
                    @if (faculty != null)
                    {
                        foreach (var fac in faculty)
                        {
                            <MudSelectItem Value="@fac.Id">@fac.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
           
            <MudItem xs="12">
                <MudSelect 
                    Adornment="Adornment.End"
                    Immediate="true"
                    AdornmentIcon="@Icons.Material.Filled.School"
                    Label="Education level"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    @bind-value="classs.EducationLevelId">
                    <MudSelectItem Value="0">--Select Education Level--</MudSelectItem>
                    @if (educationlevel != null)
                    {
                        foreach (var edu in educationlevel)
                        {
                            <MudSelectItem Value="@edu.Id">@edu.Name</MudSelectItem>
                        }
                    }
            </MudItem>

             <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>
    

@code{
      [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private AddClassDTO classs = new ();
    private List<GetFaculityDTO> faculty = new();
    private List<GetEducationLevelDTO> educationlevel = new();

    protected override async Task OnInitializedAsync()
    {


            var fac = await FaculityService.GetFaculitiesAsync();
            if (faculty != null)
            {
            faculty=fac;
            StateHasChanged();
            }

            var edu = await EducationLevelService.GetEducationLevelsAsync();
            if (edu != null)
            {
            educationlevel=edu;
            StateHasChanged();
            }
    }
    private async Task SaveClassAsync()
    {
       await ClassService.AddClassAsync(classs);
        MudDialog.Close(DialogResult.Ok(true));
    }

}