@using Application.Services.ClassServices
@using Domain.Entities
@using Application.DTOs
@using Application.Services.FaculityServices
@using Application.Services.EducationLevelServices

@rendermode InteractiveServer
@inject NavigationManager navigation
@inject IClassService ClassService
@inject IFaculityService FaculityService
@inject IEducationLevelService EducationLevelService
@page "/class/add"
<MudDialog>
    <TitleContent>Add Class</TitleContent>
    <DialogContent>
        <EditForm Model="classs" OnValidSubmit="SaveClassAsync">
           <MudGrid>
            <MudItem xs="12">
                <MudTextField 
                @bind-Value="classs.Name"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Placeholder="Class Name">
                </MudTextField>
            </MudItem>
            
           
            <MudItem xs="12">
                <MudSelect Label="Faculty" @bind-value="classs.FaculityId">
                    
                    
                    <MudSelectItem Value="0" Label="Select faculty"></MudSelectItem>
                         @if (faculty != null)
                         {
                            foreach (var fac in faculty)
                            {
                                <MudSelectItem Value="@fac.Id">@fac.Name</MudSelectItem>
                            }
                         }
                </MudSelect>
            </MudItem>
           
            <MudItem xs="12">
                <MudSelect Label="Education level" @bind-value="classs.EducationLevelId">
                    
                    <MudSelectItem Value="0" Label="Select Education level"></MudSelectItem>
                         @if (educationlevel != null)
                         {
                            foreach (var edu  in educationlevel)
                            {
                                <MudSelectItem Value="@edu.Id">@edu.Name</MudSelectItem>
                            }
                         }
                    
                </MudSelect>
            </MudItem>

             <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>
    

@code{
      [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private AddClassDTO classs = new ();
    private List<GetFaculityDTO> faculty = new();
    private List<GetEducationLevelDTO> educationlevel = new();

    protected override async Task OnInitializedAsync()
    {


            var fac = await FaculityService.GetFaculitiesAsync();
            if (faculty != null)
            {
            faculty=fac;
            StateHasChanged();
            }

            var edu = await EducationLevelService.GetEducationLevelsAsync();
            if (edu != null)
            {
            educationlevel=edu;
            StateHasChanged();
            }
    }
    private async Task SaveClassAsync()
    {
       await ClassService.AddClassAsync(classs);
        MudDialog.Close(DialogResult.Ok(true));
    }

}