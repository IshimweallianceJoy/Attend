@using Application.Services.ClassServices
@using Domain.Entities
@using Application.DTOs
@using Infrastructure.Migrations
@rendermode InteractiveServer
@inject NavigationManager navigation
@inject IClassService ClassService
@page "/class/add"
<MudDialog>
    <TitleContent>Add Class</TitleContent>
    <DialogContent>
        <EditForm Model="classs" OnValidSubmit="SaveClassAsync">
           <MudGrid>
            <MudItem xs="12">
                <MudTextField 
                @bind-Value="classs.Name"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Placeholder="Class Name">
                </MudTextField>
            </MudItem>
            
           
            <MudItem xs="12">
                <MudTextField 
                @bind-Value="classs.FaculityId"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Placeholder="Faculity ">
                </MudTextField>
            </MudItem>
           
            <MudItem xs="12">
                <MudTextField 
                @bind-Value="classs.EducationLevelId"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Placeholder="Education Level">
                </MudTextField>
            </MudItem>

             <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>
    

@code{
      [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private AddClassDTO classs = new ();
    private async Task SaveClassAsync()
    {
       await ClassService.AddClassAsync(classs);
        MudDialog.Close(DialogResult.Ok(true));
    }

}