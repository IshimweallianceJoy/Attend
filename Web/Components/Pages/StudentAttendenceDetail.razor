@* @page "/take-attendance" *@
@using Application.Services.AttendenceServices
@using Application.Services.ClassServices
@using Application.DTOs
@using Domain.ValueObject
@using Application.Services.StudentAttendenceServices


@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IAttendenceService AttendanceService
@inject IStudentAttendenceService StudentAttendanceService
@inject IClassService ClasssService

 

<MudDialog>

      <MudDataGrid T="GetStudentAttendenceDTO" 
                         Dense="true" 
                         MultiSelection="true" 
                         Items="@studentAttendances">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">Class Member</MudText>
            </ToolBarContent>

           <Columns>
                <SelectColumn T="GetStudentAttendenceDTO" />
                <PropertyColumn Property="x => x.Id" Title="Nr" Sortable="true" Filterable="false" HeaderStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" />
                <PropertyColumn Property="x => x.Student.Name" Title="Student" HeaderStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" />
                <PropertyColumn Property="x => x.Student.Id" Title="Student ID" HeaderStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" />
                <TemplateColumn Title="Status" HeaderStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.AttendenceId" Title="Attendance" HeaderStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" />
                <PropertyColumn Property="x => x.DateAdded" Title="Marked At" Format="yyyy-MM-dd" HeaderStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" />
                <TemplateColumn Title="Actions" HeaderStyle="white-space:nowrap" ItemStyle="white-space:nowrap" >
                    <CellTemplate>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open menu">
                            <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="@(() => OnPresent(context.Item))">Present</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Info" OnClick="@(() => OnAbsent(context.Item))">Absent</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Info" OnClick="@(() => OnExcused(context.Item))">Excused</MudMenuItem>
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="GetStudentAttendenceDTO" />
            </PagerContent>

        </MudDataGrid>
</MudDialog>
  
    

@code{

    private List<GetStudentAttendenceDTO> studentAttendances = new();
        private GetStudentAttendenceDTO? selectedAttendence;
    private AddAttendenceDTO attendance = new();

    // ----------------------------------------THIS IS FOR AUTO COMPLETE -------------------------------------
    private List<GetClassDTO> Classs = new();
    private GetClassDTO? selectedClass;

    private async Task<IEnumerable<GetClassDTO>> Search(string value, CancellationToken token)
    {
        await Task.Delay(5, token);

        if (string.IsNullOrEmpty(value))
        {
            return Classs;
        }

        return Classs.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    protected async override Task OnInitializedAsync()
    {
        studentAttendances = await StudentAttendanceService.GetStudentAttendencesAsync();
        Classs = await ClasssService.GetClasssesAsync();

         if (selectedAttendence is not null)
        {
            studentAttendances.Attendence.ClasssId = selectedAttendence.Id;
        }
    }

    private static Color GetStatusColor(AttendenceStatus status) => status switch
    {
        AttendenceStatus.UnTaken => Color.Default,
        AttendenceStatus.Present => Color.Success,
        AttendenceStatus.Absent => Color.Warning,   
        AttendenceStatus.Excused => Color.Error,
        _ => Color.Default
    };




    //------------------------------------------FRO UPDATING STATUS OF EACH STUDENT LIKE (PRESENT, ABSENT, ETC)------------------------------
    // -----------------------------------------THIS SERVICE IS CALLED FROM STUDENTATTENDANCE SERVICES AND STUDENTATTENDANCEREPOSITORY------------------------
    private async Task AddStudentAttendanceAsync(GetStudentAttendenceDTO item, AttendenceStatus status)
    {
        @* try
        {
            await StudentAttendanceService.AddStudentAttendanceAsync(item.Id, status);
            item.Status = status;

            Snackbar.Add($"Status updated to {status}.", Severity.Success);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        } *@
    }
    

    private Task OnPresent(GetStudentAttendenceDTO item) => AddStudentAttendanceAsync(item, AttendenceStatus.Present);
    private Task OnAbsent(GetStudentAttendenceDTO item) => AddStudentAttendanceAsync(item, AttendenceStatus.Absent);

    private Task OnExcused(GetStudentAttendenceDTO item) => AddStudentAttendanceAsync(item, AttendenceStatus.Excused);
}