@using Application.DTOs
@using Application.Services.ClassServices

@inject NavigationManager NavigationManager
@inject IClassService ClassService

 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BackToList" StartIcon="@Icons.Material.Filled.ArrowBack">Back to List</MudButton>
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2"/> Class Details
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (classs == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Class details could not be found.</MudText>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Class ID</MudText>
                    <MudText Typo="Typo.body1">@classs.Id</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Name</MudText>
                    <MudText Typo="Typo.body1">@classs.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Faculty</MudText>
                    <MudText Typo="Typo.body1">@classs.FaculityId</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Education Level</MudText>
                    <MudText Typo="Typo.body1">@classs.EducationLevelId</MudText>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>

       <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; }

    [Parameter] 
    public int Id { get; set; } 

    private bool isLoading = true;
    private GetClassDTO classs;

    protected override async Task OnParametersSetAsync()
    { 
        isLoading = true;
        try
        {
            if (Id > 0)
            {
                classs = await ClassService.GetClasssByIdAsync(Id);
            }
        }
        finally
        {
            isLoading = false;
        }
    } 

     private void Close() => MudDialog.Close();
     private void BackToList()
    {
        NavigationManager.NavigateTo("/Classes");
    }
}