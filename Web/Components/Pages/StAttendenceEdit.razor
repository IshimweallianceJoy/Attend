@using Application.DTOs
@using Application.Services.StudentAttendenceServices
@using Application.Services.AttendenceServices
@using Application.Services.StudentServices
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize] 

@inject IAttendenceService AttendenceService
@inject IStudentService StudentService

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (attend == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Class details could not be found.</MudText>
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>
            <MudForm @ref="_form">
                <MudGrid>
                  
                    <MudItem xs="12">
                        <MudSelect Adornment="Adornment.End" Immediate="true" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.Person" Label="Student"
                                   @bind-value="attend.StudentId">

                        
                            <MudSelectItem Value="0">--Select Student--</MudSelectItem>
                            @if (student != null)
                            {
                                foreach (var st in student)
                                {
                                    <MudSelectItem Value="@st.Id">@st.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudSelect Adornment="Adornment.End" Immediate="true" AdornmentIcon="@Icons.Material.Filled.School"
                                   Label="Class" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   @bind-value="attend.AttendenceId">

                            <MudSelectItem Value="0">--Select Class--</MudSelectItem>
                            @if (attendence != null)
                            {
                                foreach (var at in attendence)
                                {
                                    <MudSelectItem Value="@at.Id">@at.Classs.Name</MudSelectItem>
                                }
                            }

                        </MudSelect>

                    </MudItem>

                </MudGrid>
                <MudButton OnClick="Save" Disabled="@isLoading" Color="Color.Primary" Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit">EDIT</MudButton>
            </MudForm>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Inject]
    public IStudentAttendenceService StudentAttendenceService { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public int Id { get; set; }

    private bool isLoading = true;
    private GetStudentAttendenceDTO? attend;
    private MudForm? _form;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (Id > 0)
        {
            attend = await StudentAttendenceService.GetStudentAttendenceByIdAsync(Id);
        }

        isLoading = false;
    }
    private List<GetAttendenceDTO> attendence = new();
    private List<GetStudentDTO> student = new();

    protected override async Task OnInitializedAsync()
    {


        var at = await AttendenceService.GetAttendencesAsync();
        if (attendence != null)
        {
            attendence = at;
            StateHasChanged();
        }

        var st = await StudentService.GetStudentsAsync();
        if (st != null)
        {
            student = st;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (_form == null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid || attend == null)
            return;

        await StudentAttendenceService.UpdateStudentAttendenceAsync(new UpdateStudentAttendenceDTO
        {
            Id = attend.Id,
            StudentId = attend.StudentId,
            AttendenceId = attend.AttendenceId,
            
        });

        MudDialog?.Close(DialogResult.Ok(attend));
        StateHasChanged();
    }

   
}