@using Application.Services.StudentAttendenceServices
@using Domain.Entities
@using Application.DTOs
@using Application.Services.AttendenceServices
@using Application.Services.StudentServices
@using Application.Services.ClassServices
@using Domain.ValueObject



@rendermode InteractiveServer
@inject NavigationManager navigation
@inject IStudentAttendenceService StudentAttendenceService
@inject IAttendenceService AttendenceService
@inject IStudentService StudentService
@inject IClassService ClassService
@inject ISnackbar Snackbar

@page "/Stattendence/add"
<MudDialog>
    <TitleContent>Add Attendence</TitleContent>
    <DialogContent>
        <EditForm Model="stattendence" OnValidSubmit="SavestAttendenceAsync">
           <MudGrid>
           
            
           
            <MudItem xs="12">
                <MudSelect 
                    Adornment="Adornment.End"
                    Immediate="true"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    AdornmentIcon="@Icons.Material.Filled.LibraryBooks"
                    Label="Class"
                    @bind-value="stattendence.AttendenceId">
                        
                        
                        <MudSelectItem Value="0">--Select Attendence--</MudSelectItem>
                            @if (attendences != null)
                            {
                                foreach (var attendence in attendences)
                                {
                                    <MudSelectItem Value="@attendence.Id">@attendence.Classs.Name - @attendence.UserAdded - @attendence.DateAdded</MudSelectItem>
                                }
                            }
                </MudSelect>
            </MudItem>

             <MudItem xs="12">
                <MudSelect 
                    Adornment="Adornment.End"
                    Immediate="true"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    AdornmentIcon="@Icons.Material.Filled.Person"
                    Label="Student"
                    @bind-value="stattendence.StudentId">
                        
                        
                        <MudSelectItem Value="0">--Select Student--</MudSelectItem>
                            @if (student != null)
                            {
                                foreach (var st in student)
                                {
                                    <MudSelectItem Value="@st.Id">@st.Name</MudSelectItem>
                                }
                            }
                </MudSelect>
            </MudItem>

             <MudItem  xs="12">
                    <MudSelect T="AttendenceStatus"
                            Label="Status"
                            @bind-Value="stattendence.Status"
                            Variant="Variant.Outlined"
                            Dense="true"
                            Margin="Margin.Dense"
                            AdornmentIcon="@Icons.Material.Filled.Category"
                            AdornmentColor="Color.Primary">

                        <MudSelectItem T="StudentStatus">--Select Attendence Status--</MudSelectItem>

                        @foreach (AttendenceStatus status in Enum.GetValues(typeof(AttendenceStatus)))
                        {
                            <MudSelectItem T="AttendenceStatus" Value="status">@status.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

               
           
          

             <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>
    

@code{
      [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
     [Parameter]
    public GetAttendenceDTO? selectedAttendence {get;set;}
     private List<GetStudentAttendenceDTO> stattendences = new();
     
    private AddStudentAttendenceDTO stattendence = new ();
    private List<GetAttendenceDTO> attendences = new();

     private List<GetStudentDTO> student = new();
    private List<GetStudentAttendenceDTO> filteredRegistration => stattendences.Where(r => selectedAttendence is null || r.AttendenceId == selectedAttendence.Id)
            .ToList();
   

    protected override async Task OnInitializedAsync()
    {


            var at = await AttendenceService.GetAttendencesAsync();
            if (attendences != null)
            {
            attendences=at;
            StateHasChanged();
            }

            var st = await StudentService.GetStudentsAsync();
            if (student != null)
            {
            student=st;
            StateHasChanged();
            }
            
             if (selectedAttendence is not null)
        {
            stattendence.AttendenceId = selectedAttendence.Id;
        }

           
    }

    
    private async Task SavestAttendenceAsync()
    {
          try
        {
       await StudentAttendenceService.AddStudentAttendenceAsync(stattendence);
        MudDialog.Close(DialogResult.Ok(true));
             stattendences = await StudentAttendenceService.GetStudentAttendencesAsync();
            Snackbar.Add("Student added successfully.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

}