@using Application.Services.ClassStudentServices
@using Application.DTOs
@using Domain.Entities
@using Application.Services.ClassServices
@using Application.Services.StudentServices
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IStudentService StudentService
@inject IClassService ClassService
@inject IClassStudentService ClassStudentService
@page "/classStudent/add"

 <MudDialog>
    <TitleContent>Add Class_Student</TitleContent>
    <DialogContent>
        <EditForm Model="classstudent" OnValidSubmit="SaveClassStudentAsync">
           <MudGrid>
              
            <MudItem xs="12">
                <MudSelect
                Adornment="Adornment.End"
                Immediate="true"
                 Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 AdornmentIcon="@Icons.Material.Filled.Person"
                 Label="Class"
                  @bind-value="classstudent.ClasssId">
                    
                    
                    <MudSelectItem Value="0" Label="Select Class"></MudSelectItem>
                         @if (Classs != null)
                         {
                            foreach (var c in Classs)
                            {
                                <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                            }
                         }
                </MudSelect>
            </MudItem>
           
            <MudItem xs="12">
                <MudSelect 
                Adornment="Adornment.End"
                Immediate="true"
                 AdornmentIcon="@Icons.Material.Filled.Person"
                  Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Label="Student" 
                @bind-value="classstudent.StudentId">
                    
                    <MudSelectItem Value="0" Label="Select Student"></MudSelectItem>
                         @if (Student != null)
                         {
                            foreach (var st  in Student)
                            {
                                <MudSelectItem Value="@st.Id">@st.Name</MudSelectItem>
                            }
                         }
                    
                </MudSelect>
            </MudItem>


            <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>
@code
    {
      [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private AddClassStudentDTO classstudent = new ();

        private List<GetClassDTO> Classs = new();
    private List<GetStudentDTO> Student = new();

    protected override async Task OnInitializedAsync()
    {


            var c = await ClassService.GetClasssesAsync();
            if (Classs != null)
            {
            Classs=c;
            StateHasChanged();
            }

            var st = await StudentService.GetStudentsAsync();
            if (st != null)
            {
            Student=st;
            StateHasChanged();
            }
    }


    private async Task SaveClassStudentAsync()
    {
        await ClassStudentService.AddClassStudentAsync(classstudent);
        MudDialog.Close(DialogResult.Ok(true));
    }
}