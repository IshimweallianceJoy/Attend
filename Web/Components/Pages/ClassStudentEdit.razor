
@using Application.DTOs
@using Application.Services.ClassStudentServices
@using Application.Services.ClassServices
@using Application.Services.StudentServices
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize] 

@inject IClassService ClassService
@inject IStudentService StudentService

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (classs == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Class details could not be found.</MudText>
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>
            <MudForm @ref="_form">
                <MudGrid>
                 
                    <MudItem xs="12">
                        <MudSelect Adornment="Adornment.End" Immediate="true" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.LibraryBooks" Label="Class"
                                   @bind-value="classst.ClasssId">

                        
                            <MudSelectItem Value="0">--Select Class--</MudSelectItem>
                            @if (classs != null)
                            {
                                foreach (var c in classs)
                                {
                                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudSelect Adornment="Adornment.End" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Person"
                                   Label="Student" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   @bind-value="classst.StudentId">

                            <MudSelectItem Value="0">--Select Student--</MudSelectItem>
                            @if (student != null)
                            {
                                foreach (var st in student)
                                {
                                    <MudSelectItem Value="@st.Id">@st.Name</MudSelectItem>
                                }
                            }

                        </MudSelect>

                    </MudItem>

                </MudGrid>
                <MudButton OnClick="Save" Disabled="@isLoading" Color="Color.Primary" Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit">EDIT</MudButton>
            </MudForm>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Inject]
    public IClassStudentService ClassStudentService { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public int Id { get; set; }

    private bool isLoading = true;
    private GetClassStudentDTO? classst;
    private MudForm? _form;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (Id > 0)
        {
            classst = await ClassStudentService.GetClassStudentByIdAsync(Id);
        }

        isLoading = false;
    }
    private List<GetClassDTO> classs = new();
    private List<GetStudentDTO> student = new();

    protected override async Task OnInitializedAsync()
    {


        var c = await ClassService.GetClasssesAsync();
        if (classs != null)
        {
            classs = c;
            StateHasChanged();
        }

        var st = await StudentService.GetStudentsAsync();
        if (st != null)
        {
            student = st;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (_form == null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid || classst == null)
            return;

        await ClassStudentService.UpdateClassStudentAsync(new UpdateClassStudentDTO
        {
            Id = classst.Id,
            ClasssId = classst.ClasssId,
            StudentId = classst.StudentId,
            
        });

        MudDialog?.Close(DialogResult.Ok(classst));
        StateHasChanged();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }
}