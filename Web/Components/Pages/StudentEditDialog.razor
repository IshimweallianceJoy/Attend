@using Application.DTOs
@using Application.Services.StudentServices

@inject IStudentService StudentService

<MudDialog  Style="overflow:hidden; max-width: 500px; width: 100%;">
    <DialogContent>
         @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (student == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Student could not be found.</MudText>
        }
        else
        {
        <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>
        <MudForm @ref="_form">
          <MudGrid>
            <MudItem xs="12">
            <MudNumericField  @bind-Value="student.Id" Label="Id" Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" RequiredError="Faculty ID is required." Class="mb-3" />
            </MudItem>
            <MudItem xs="12">
            <MudTextField @bind-Value="student.Name" Label="Name" Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" RequiredError="Name is required." Class="mb-3" />
            </MudItem>
            <MudItem xs="12">
            <MudSelect  label="Sex" @bind-Value="student.Sex" Margin="Margin.Dense" Variant="Variant.Outlined"  Placeholder="select sex">
                @* <MudSelectItem Value="@SexStatus.Male">Male</MudSelectItem>
                <MudSelectItem Value="@SexStatus.Female">Female</MudSelectItem> *@
            </MudSelect>
            </MudItem>
            <MudItem xs="12">
             <MudTextField @bind-Value="student.Phone" Label="Phone" Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" RequiredError="Phone Number is required." Class="mb-3" />
             </MudItem>
             <MudItem xs="12">
             <MudTextField @bind-Value="student.ParentNames" Label="ParentNames" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Parent Names is required." Class="mb-3" />
             </MudItem>
             <MudItem xs="12">
              <MudTextField @bind-Value="student.ParentPhone" Label="ParentPhone" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Parent Phone is required." Class="mb-3" />
              </MudItem>
              <MudItem xs="12">
            <MudTextField @bind-Value="student.Adress" Label="Adress" Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" RequiredError="Address is required." Class="mb-3" />
            </MudItem>
         </MudGrid>
         <MudButton  OnClick="Save" xs="12" Disabled="@isLoading" Color="Color.Primary" Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit">EDIT</MudButton>
        </MudForm>
         
        }
    </DialogContent>
        
</MudDialog>

@code{

    
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public int Id { get; set; }

    private bool isLoading = true;
    private GetStudentDTO? student;
    private MudForm? _form;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (Id > 0)
        {
            student = await StudentService.GetStudentByIdAsync(Id);
        }

        isLoading = false;
    }

    private async Task Save()
    {
        if (_form == null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid || student == null)
            return;

        await StudentService.UpdateStudentAsync(new UpdateStudentDTO
        {
            Id = student.Id,
            Name = student.Name,
            Sex = student.Sex,
            Adress = student.Adress,
            Phone = student.Phone,
            ParentNames = student.ParentNames,
            ParentPhone = student.ParentPhone
        });

        MudDialog?.Close(DialogResult.Ok(student));
        StateHasChanged();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }
}