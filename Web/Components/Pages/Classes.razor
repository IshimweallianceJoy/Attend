  <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4" >
        <MudDataGrid T="GetClassDTO" MultiSelection="true" Items="@classes" SortMode="SortMode.Multiple" Filterable="true" QuickFilter="@_quickFilter"
                     Hideable="true" RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" SelectedItemsChanged="@SelectedItemsChanged">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">Classes</MudText>
                <MudSpacer />
                <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-none d-md-flex">
                  <MudTextField 
                    @bind-Value="_searchString" 
                    Placeholder="Search" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    AdornmentIcon="@Icons.Material.Filled.Search" 
                    IconSize="Size.Medium" 
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Class="mt-1 w-100">
                  </MudTextField>
                </MudContainer>

                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="ml-4" @onclick="() => OpenDialogAsync(_closeButton)" >Add Class</MudButton>
            
            </ToolBarContent>

            <Columns>
                <SelectColumn T="GetClassDTO" />
                <PropertyColumn Property="x => x.Id" Title="Nr" Sortable="true" Filterable="false" />
                <PropertyColumn Property="x => x.Name" />
                <PropertyColumn Property="x => x.Faculity.Name" SortBy="@_sortBy" Title="Faculty" />
                <PropertyColumn Property="x => x.EducationLevel.Name" Title="Education Level" />  
                <PropertyColumn Property="x => x.UserAdded" Title="User Added" />
                <PropertyColumn Property="x => x.DateAdded" Title="Date Added" />       
                 <TemplateColumn Title="Status">
                 <CellTemplate>
                    <MudChip T="String"
                    Size="Size.Medium"
                    Variant="Variant.Filled"
                    Color="@GetStatusColor(context.Item.Status)">
                    @context.Item.Status
                    </MudChip>
                 </CellTemplate>
                </TemplateColumn>
                <TemplateColumn CellClass="d-flex justify-end" Title="Actions">
                    <CellTemplate>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Class Details Menu">
                            <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="@(() => OnOpenRegistration(context.Item, _closeButton))" >Add Student</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="@(() => ViewClassAsync(context.Item))">Details</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit"  Color="Color.Primary" OnClick="@(() => EditClassAsync(context.Item, _closeButton))">Edit</MudMenuItem>
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GetClassDTO" />
            </PagerContent>

        </MudDataGrid>
</MudContainer>
@code{

    private string _searchString;
    private bool _sortNameByLength;
    private List<string> _events = new();
    protected IDialogReference dialogReference;

    void RowClicked(DataGridRowClickEventArgs<GetClassDTO> args)
    {
        _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void RowRightClicked(DataGridRowClickEventArgs<GetClassDTO> args)
    {
        _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void SelectedItemsChanged(HashSet<GetClassDTO> items)
    {
        _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
    }
            private static Color GetStatusColor(ClassStatus status) => status switch
        {
            ClassStatus.Active => Color.Success,
            @* ClassStatus.Full => Color.Warning,
            ClassStatus.Ongoing => Color.Info, *@
            ClassStatus.Deleted => Color.Error,
            _ => Color.Default
        };

    

    private Func<GetClassDTO, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return (object)x.Name.Length;
        else
            return x.Name;
    };
    // quick filter - filter globally across multiple columns with the same input
    private Func<GetClassDTO, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.FaculityId.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.EducationLevelId.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    private List<GetClassDTO> classes= new ();
    protected override async Task OnInitializedAsync()
    {
        classes = await ClassService.GetClasssesAsync();
    }
    private readonly DialogOptions _closeButton = new() { CloseButton = true };
    private async Task OpenDialogAsync(DialogOptions options)
    {
        var dialog = await DialogService.ShowAsync<AddClass>("Add New Class", options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            classes = await ClassService.GetClasssesAsync();
        }
    }



    private async Task ViewClassAsync(GetClassDTO classs)
    {
        var parameters = new DialogParameters
        {
            { nameof(ClassDetailDialog.Id), classs.Id } // Pass the Id directly
        };

        var dialog = await DialogService.ShowAsync<ClassDetailDialog>("Class Details", parameters);
    }

    private async Task EditClassAsync(GetClassDTO classs, DialogOptions options)
    {
        var parameters = new DialogParameters
        {
            { nameof(ClassEditDialog.Id), classs.Id } // Pass the Id directly
        };

        var dialog = await DialogService.ShowAsync<ClassEditDialog>("Edit Class", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            classes = await ClassService.GetClasssesAsync();
            StateHasChanged();
        }
    }
      private async Task OnOpenRegistration(GetClassDTO classss, DialogOptions options)
        { 
            //this is parameter which is passed to the Registration.razor page so that it can be used to get the classid of the selected class when you click the add student menuitem
           var parameters = new DialogParameters
            {
                { nameof(AddClassStudent.selectedClass), classss }
            };

            var dialog = await DialogService.ShowAsync<AddClassStudent>("Add New Class", parameters, options);
                
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
            {

            }
        } 

        


}