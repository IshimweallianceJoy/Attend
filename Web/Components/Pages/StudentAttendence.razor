@page "/Stattendence"
@using Application.Services.StudentAttendenceServices
@using Application.DTOs;
@using Domain.Entities;
@using Microsoft.AspNetCore.Components;
@using Microsoft.EntityFrameworkCore;
@using Domain.ValueObject;

@inject IDialogService DialogService
@inject IStudentAttendenceService StudentAttendenceService



  <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4" >
        <MudDataGrid T="GetStudentAttendenceDTO" MultiSelection="true" Items="@stattendences" SortMode="SortMode.Multiple" Filterable="true" 
            Hideable="true" RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" SelectedItemsChanged="@SelectedItemsChanged">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">Classes</MudText>
                <MudSpacer />
                <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-none d-md-flex">
                  <MudTextField 
                    @bind-Value="_searchString" 
                    Placeholder="Search" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    AdornmentIcon="@Icons.Material.Filled.Search" 
                    IconSize="Size.Medium" 
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Class="mt-1 w-100">
                  </MudTextField>
                </MudContainer>

                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="ml-4" @onclick="() => OpenDialogAsync(_closeButton)" >Add Attendence</MudButton>
            
            </ToolBarContent>

            <Columns>
                <SelectColumn T="GetStudentAttendenceDTO" />
                <PropertyColumn Property="x => x.Id" Title="Nr" Sortable="true" Filterable="false" /> 
                 <PropertyColumn Property="x => x.Student.Name" Title="Student" />  
                 <PropertyColumn Property="x => x.Attendence.Classs.Name" Title="Class" />    
                 <PropertyColumn Property="x => x.Attendence.UserAdded" Title="Done By" />  
                 
                <TemplateColumn Title="Status">
                 <CellTemplate>
                    <MudChip T="String"
                    Size="Size.Medium"
                    Variant="Variant.Filled"
                    Color="@GetStatusColor(context.Item.Status)">
                    @context.Item.Status
                    </MudChip>
                 </CellTemplate>
                </TemplateColumn>
                  <TemplateColumn Title="Actions">    
                <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" @onclick="() => ViewStudentAttendenceAsync(context.Item)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() =>  EditStudentAttendenceAsync(context.Item, _closeButton))" />
                    </CellTemplate>
                </TemplateColumn>

                
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GetStudentAttendenceDTO" />
            </PagerContent>

        </MudDataGrid>
</MudContainer>
@code{

    
      private string _searchString;
        private bool _sortNameByLength;
        private List<string> _events = new();
                 private static Color GetStatusColor(AttendenceStatus status) => status switch
        {
            AttendenceStatus.Present => Color.Success,
            AttendenceStatus.Absent => Color.Warning,
            @* AttendenceStatus.Ongoing => Color.Info, *@
            AttendenceStatus.Deleted => Color.Error,
            _ => Color.Default
        };

        void RowClicked(DataGridRowClickEventArgs<GetStudentAttendenceDTO> args)
        {
            _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }
        
        void RowRightClicked(DataGridRowClickEventArgs<GetStudentAttendenceDTO> args)
        {
            _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }

        void SelectedItemsChanged(HashSet<GetStudentAttendenceDTO> items)
        {
            _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
        }


        @* private Func<GetAttendenceDTO, object> _sortBy => x =>
        {
            if (_sortNameByLength)
                return x.Name.Length;
            else
                return x.Name;
        };
        // quick filter - filter globally across multiple columns with the same input
        private Func<GetAttendenceDTO, bool> _quickFilter => x =>
        {
            if (string.IsNullOrWhiteSpace(_searchString))
                return true;

            if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            if (x.FaculityId.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            if (x.EducationLevelId.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            return false;
        }; *@
   
    private List<GetStudentAttendenceDTO> stattendences= new List<GetStudentAttendenceDTO>();
    protected override async Task OnInitializedAsync()
    {
        stattendences = await StudentAttendenceService.GetStudentAttendencesAsync();
    }
    private readonly DialogOptions _closeButton = new() { CloseButton = true };
        private async Task OpenDialogAsync(DialogOptions options)
        {
            var dialog = await DialogService.ShowAsync<AddStAttendence>("Add New Attendence", options);
                
            var result = await dialog.Result;

            if (result is not null && !result.Canceled) 
            {
                stattendences = await StudentAttendenceService.GetStudentAttendencesAsync();
            }
        }

         private async Task ViewStudentAttendenceAsync(GetStudentAttendenceDTO stattendence)
            {
                @* var parameters = new DialogParameters
                {
                    { nameof(StAttendenceDetails.Id), stattendence.Id } // Pass the Id directly
                };

                var dialog = await DialogService.ShowAsync<StAttendenceDetails>("Student_Attendence Details", parameters); *@
            }

            private async Task EditStudentAttendenceAsync(GetStudentAttendenceDTO stattendence, DialogOptions options)
            {
                var parameters = new DialogParameters
                {
                    { nameof(StAttendenceEdit.Id), stattendence.Id } // Pass the Id directly
                };

                var dialog = await DialogService.ShowAsync<StAttendenceEdit>("Edit Student_Attendence", parameters, options);
                
                var result = await dialog.Result;

                if (result is not null && !result.Canceled)
                {
                    stattendences = await StudentAttendenceService.GetStudentAttendencesAsync();
                    StateHasChanged();
                }
            }

}