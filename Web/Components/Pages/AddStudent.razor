@using Application.Services.StudentServices
@using Application.DTOs
@using Domain.Entities
@using Domain.ValueObject
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize] 

@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IStudentService StudentService
@page "/students/add"

 <MudDialog>
    <TitleContent>Add Student</TitleContent>
    <DialogContent>
        <EditForm Model="student" OnValidSubmit="SaveStudentAsync">
           <MudGrid>
            <MudItem xs="6">
                <MudTextField 
                label="Fullname"
                @bind-Value="student.Name"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                Adornment="Adornment.End"
                Immediate="true"
                AdornmentIcon="@Icons.Material.Filled.Person"
                Placeholder="Student Name">

                </MudTextField>
            </MudItem>
            <MudItem xs="6">
                <MudSelect 
                Label="Sex"
                @bind-Value="student.Sex"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                AdornmentIcon="@Icons.Material.Filled.Transgender"
                Placeholder="select sex">
                @foreach (SexStatus sex in Enum.GetValues(typeof(SexStatus)) )
                {
                    <MudSelectItem Value="sex">@sex</MudSelectItem>
                }

                </MudSelect>
            </MudItem>

            <MudItem xs="6">
                <MudDatePicker 
                label="Date of Birth"
                Date="student.DOB"
                DateChanged="date => student.DOB = date ?? default"
                Margin="Margin.Dense"
                DateFormat="yyyy-MM-dd"
                Variant="Variant.Outlined"
               
                Placeholder="dd/mm/yyyy">
                </MudDatePicker>
            </MudItem>
            
            <MudItem xs="6">
                <MudTextField 
                label="Email"
                @bind-Value="student.Email"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                Immediate="true"
                 AdornmentIcon="@Icons.Material.Filled.Email"
                Placeholder="mellissa@gmail.com">
                </MudTextField>
            </MudItem>
            <MudItem xs="6">
                <MudTextField 
                label="Phone Number"
                @bind-Value="student.Phone"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                Immediate="true"
                AdornmentIcon="@Icons.Material.Filled.Phone"
                Placeholder="078 2828 2828">
                </MudTextField>
            </MudItem>
           
            <MudItem xs="6">
                <MudTextField 
                label="Address"
                @bind-Value="student.Adress"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                Immediate="true"
                AdornmentIcon="@Icons.Material.Filled.LocationOn"
                Placeholder="Kigali-Rwanda">
                </MudTextField>
            </MudItem>

            <MudItem xs="6">
                <MudTextField 
                label="Registration Number"
                @bind-Value="student.RegNumber"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                Immediate="true"
                AdornmentIcon="@Icons.Material.Filled.AppRegistration"
                Placeholder="2023-0001">
                </MudTextField>
            </MudItem>

            <MudItem xs="6">
                <MudTextField 
                label="Parent Names"
                @bind-Value="student.ParentNames"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                Immediate="true"
                AdornmentIcon="@Icons.Material.Filled.PeopleAlt"
                Placeholder="Parent Names">
                </MudTextField>
            </MudItem>

            <MudItem xs="6">
                <MudTextField 
                label="Parent Phone"
                @bind-Value="student.ParentPhone"
                Margin="Margin.Dense"
                Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                Immediate="true"
                AdornmentIcon="@Icons.Material.Filled.Phone"
                Placeholder="Parent Phone">
                </MudTextField>
            </MudItem>

        

                  <MudItem xs="12">
                <MudButton 
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth="true" 
                ButtonType="ButtonType.Submit">
                SAVE
                </MudButton>
            </MudItem>

           </MudGrid> 
        </EditForm>

    </DialogContent>
    
</MudDialog>
@code
    {
      [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private AddStudentDTO student = new ();

    private async Task SaveStudentAsync()
    {
        await StudentService.AddStudentAsync(student);
        MudDialog.Close(DialogResult.Ok(true));
    }
    private List<SexStatus> SexValues = new ();
}
 