@using Application.DTOs
@using Application.Services.ClassStudentServices
@using Application.Services.ClassServices
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize] 
@inject NavigationManager NavigationManager
@inject IClassService ClassService
@inject IClassStudentService ClassStudentService

 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BackToList" StartIcon="@Icons.Material.Filled.ArrowBack">Back to List</MudButton>
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2"/> Class Details
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (classst == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Class details could not be found.</MudText>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Class_Student ID</MudText>
                    <MudText Typo="Typo.body1">@classst.Id</MudText>
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Class</MudText>
                    <MudText Typo="Typo.body1"
                    @bind-value=classst.ClasssId>
                         @if (Classs != null)
                         {
                            foreach (var c in Classs)
                            {
                                <MudSelectItem Value="@c.Id">@c.Name - @c.Faculity.Name </MudSelectItem>
                            }
                         }
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Student</MudText>
                    <MudText Typo="Typo.body1">@classst.Student.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Start Date</MudText>
                    <MudText Typo="Typo.body1">@classst.StartDate</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">End Date</MudText>
                    <MudText Typo="Typo.body1">@classst.EndDate</MudText>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>

       <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; }

    [Parameter] 
    public int Id { get; set; } 

    private bool isLoading = true;
    private GetClassStudentDTO classst;

private List<GetClassDTO> Classs = new();
    protected override async Task OnParametersSetAsync()
    { 
        isLoading = true;
        try
        {
            if (Id > 0)
            {
                classst = await ClassStudentService.GetClassStudentByIdAsync(Id);
            }
        }
        finally
        {
            isLoading = false;
        }
    } 
     protected override async Task OnInitializedAsync()
    {


            var c = await ClassService.GetClasssesAsync();
            if (Classs != null)
            {
            Classs=c;
            StateHasChanged();
            }

           
    }

     private void Close() => MudDialog.Close();
     private void BackToList()
    {
        NavigationManager.NavigateTo("/classStudent");
    }
}