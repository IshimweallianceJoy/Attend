@using Application.DTOs
@using Application.Services.ClassServices
@using Application.Services.FaculityServices
@using Application.Services.EducationLevelServices

@inject IFaculityService FaculityService
@inject IEducationLevelService EducationLevelService

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (classs == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Class details could not be found.</MudText>
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>
            <MudForm @ref="_form">
                <MudGrid>
                    <MudItem xs="12">

                        <MudTextField @bind-Value="classs.Name" Label="Name" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Required="true" RequiredError="Name is required." />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect Adornment="Adornment.End" Immediate="true" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.LibraryBooks" Label="Faculty"
                                   @bind-value="classs.FaculityId">

                        
                            <MudSelectItem Value="0">--Select faculty--</MudSelectItem>
                            @if (faculty != null)
                            {
                                foreach (var fac in faculty)
                                {
                                    <MudSelectItem Value="@fac.Id">@fac.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudSelect Adornment="Adornment.End" Immediate="true" AdornmentIcon="@Icons.Material.Filled.School"
                                   Label="Education level" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   @bind-value="classs.EducationLevelId">

                            <MudSelectItem Value="0">--Select Education Level--</MudSelectItem>
                            @if (educationlevel != null)
                            {
                                foreach (var edu in educationlevel)
                                {
                                    <MudSelectItem Value="@edu.Id">@edu.Name</MudSelectItem>
                                }
                            }

                        </MudSelect>

                    </MudItem>

                </MudGrid>
                <MudButton OnClick="Save" Disabled="@isLoading" Color="Color.Primary" Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit">EDIT</MudButton>
            </MudForm>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Inject]
    public IClassService ClassService { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public int Id { get; set; }

    private bool isLoading = true;
    private GetClassDTO? classs;
    private MudForm? _form;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (Id > 0)
        {
            classs = await ClassService.GetClasssByIdAsync(Id);
        }

        isLoading = false;
    }
    private List<GetFaculityDTO> faculty = new();
    private List<GetEducationLevelDTO> educationlevel = new();

    protected override async Task OnInitializedAsync()
    {


        var fac = await FaculityService.GetFaculitiesAsync();
        if (faculty != null)
        {
            faculty = fac;
            StateHasChanged();
        }

        var edu = await EducationLevelService.GetEducationLevelsAsync();
        if (edu != null)
        {
            educationlevel = edu;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (_form == null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid || classs == null)
            return;

        await ClassService.UpdateClassAsync(new UpdateClassDTO
        {
            Id = classs.Id,
            Name = classs.Name,
            FaculityId = classs.FaculityId,
            EducationLevelId = classs.EducationLevelId
        });

        MudDialog?.Close(DialogResult.Ok(classs));
        StateHasChanged();
    }

   
}