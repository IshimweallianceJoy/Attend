@page "/classStudent"
@using Application.Services.ClassStudentServices
@using Application.DTOs;
@using Domain.Entities;
@using Domain.ValueObject;
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize] 

@inject IDialogService DialogService
@inject IClassStudentService ClassStudentService
@* 
<h1>ClassStudent</h1>
<table>
    <tr>
<th>ClasssId</th>
<th>StudentId</th>

</tr>

@foreach(var classst in classStudents){
<tr>
    <td>@classst.ClasssId</td>
    <td>@classst.StudentId</td>
</tr>
}

</table> *@


  <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4" >
        <MudDataGrid T="GetClassStudentDTO" MultiSelection="true" Items="@classstudents" SortMode="SortMode.Multiple" Filterable="true" 
            Hideable="true" RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" SelectedItemsChanged="@SelectedItemsChanged">
            
            <ToolBarContent>
                <MudText Typo="Typo.h6">Class_Student</MudText>
                <MudSpacer />
                <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-none d-md-flex">
                  <MudTextField 
                    @bind-Value="_searchString" 
                    Placeholder="Search" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    AdornmentIcon="@Icons.Material.Filled.Search" 
                    IconSize="Size.Medium" 
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Class="mt-1 w-100">
                  </MudTextField>
                </MudContainer>

                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="ml-4" @onclick="() => OpenDialogAsync(_closeButton)" >Add Class_Student</MudButton>
            
            </ToolBarContent>

            <Columns>
                <SelectColumn T="GetClassStudentDTO" />
                <PropertyColumn Property="x => x.Id" Title="Nr" Sortable="true" Filterable="false" /> 
                <PropertyColumn Property="x => x.Classs.Name" Title="Class" />
                <PropertyColumn Property="x => x.Classs.Faculity.Name" Title="  Faculity" />
                <PropertyColumn Property="x => x.Student.Name" Title="Student" />
                <PropertyColumn Property="x => x.StartDate" Title="Academic year 
                Start Date" />
                <PropertyColumn Property="x => x.EndDate" Title="Academic year
                 End Date" />
                <PropertyColumn Property="x => x.DateAdded" Title="Date Added" />
                 <TemplateColumn Title="Status">
                 <CellTemplate>
                    <MudChip T="String"
                    Size="Size.Medium"
                    Variant="Variant.Filled"
                    Color="@GetStatusColor(context.Item.Status)">
                    @context.Item.Status
                    </MudChip>
                 </CellTemplate>
                </TemplateColumn>

                <TemplateColumn CellClass="d-flex justify-end" Title="Actions">
                  <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" OnClick="@(() => ViewClassStudentAsync(context.Item, _closeButton))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => EditClassStudentAsync(context.Item, _closeButton))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GetClassStudentDTO" />
            </PagerContent>

        </MudDataGrid>
</MudContainer>

@code{

      private string _searchString;
        private bool _sortNameByLength;
        private List<string> _events = new();
            
             private static Color GetStatusColor(ClassStudentStatus status) => status switch
        {
            ClassStudentStatus.Active => Color.Success,
            @* ClassStudentStatus.Full => Color.Warning,
            ClassStudentStatus.Ongoing => Color.Info, *@
            ClassStudentStatus.Deleted => Color.Error,
            _ => Color.Default
        };

        void RowClicked(DataGridRowClickEventArgs<GetClassStudentDTO> args)
        {
            _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }
        
        void RowRightClicked(DataGridRowClickEventArgs<GetClassStudentDTO> args)
        {
            _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
        }

        void SelectedItemsChanged(HashSet<GetClassStudentDTO> items)
        {
            _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
        }


        @* private Func<GetClassStudentDTO, object> _sortBy => x =>
        {
            if (_sortNameByLength)
                return x.ClasssId.Length;
            else
                return x.ClasssId;
        };
        // quick filter - filter globally across multiple columns with the same input
        private Func<GetClassStudentDTO, bool> _quickFilter => x =>
        {
            if (string.IsNullOrWhiteSpace(_searchString))
                return true;

            if (x.Classs.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            if (x.Student.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;

            return false;
        }; *@
   
    private List<GetClassStudentDTO> classstudents= new List<GetClassStudentDTO>();
    protected override async Task OnInitializedAsync()
    {
        classstudents = await ClassStudentService.GetClassStudentsAsync();
    }
    
    private readonly DialogOptions _closeButton = new() { CloseButton = true };
        private async Task OpenDialogAsync(DialogOptions options)
        {
            var dialog = await DialogService.ShowAsync<AddClassStudent>("Add New Class_Student", options);
                
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
            {
                classstudents = await ClassStudentService.GetClassStudentsAsync();
            }
        }

          private async Task ViewClassStudentAsync(GetClassStudentDTO clssstudent, DialogOptions options)
            {
                var parameters = new DialogParameters
                {
                    { nameof(ClassStudentDitails.Id), clssstudent.Id } // Pass the Id directly
                };

                var dialog = await DialogService.ShowAsync<ClassStudentDitails>("Class_Student Details", parameters, options);
            }

            private async Task EditClassStudentAsync(GetClassStudentDTO clssstudent, DialogOptions options)
            {
                var parameters = new DialogParameters
                {
                    { nameof(ClassStudentEdit.Id), clssstudent.Id } // Pass the Id directly
                };

                var dialog = await DialogService.ShowAsync<ClassStudentEdit>("Edit Class_Student", parameters, options);
                
                var result = await dialog.Result;

                if (result is not null && !result.Canceled)
                {
                    classstudents = await ClassStudentService.GetClassStudentsAsync();
                    StateHasChanged();
                }
            }
    
}

}


