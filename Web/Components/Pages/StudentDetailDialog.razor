@using Application.DTOs
@using Application.Services.StudentServices

@inject NavigationManager NavigationManager

@inject IStudentService StudentService

 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BackToList" StartIcon="@Icons.Material.Filled.ArrowBack">Back to List</MudButton>

<MudDialog>

      <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2"/> Student Details
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (student == null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error">Student details could not be found.</MudText>
        }
        else
        {
        
        <MudGrid>
            <MudItem>
                <MudText Typo="Typo.h6">Student ID</MudText>
                <MudText Typo="Typo.body1">@student.Id</MudText>
            </MudItem>
            <MudItem>
                <MudText Typo="Typo.h6">Name</MudText>
                <MudText Typo="Typo.body1">@student.Name</MudText>
            </MudItem>
            <MudItem>
                <MudText Typo="Typo.h6">Date of Birth</MudText>
                <MudText Typo="Typo.body1">@student.DOB</MudText>
            </MudItem>
            <MudItem>
                <MudText Typo="Typo.h6">Sex</MudText>
                <MudText Typo="Typo.body1">@student.Sex</MudText>
            </MudItem>
            <MudItem>
                <MudText Typo="Typo.h6">Phone</MudText>
                <MudText Typo="Typo.body1">@student.Phone</MudText>
            </MudItem>
            <MudItem>
                <MudText Typo="Typo.h6">Reg Number</MudText>
                <MudText Typo="Typo.body1">@student.RegNumber</MudText>
            </MudItem>
        </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
    
</MudDialog>
  
    

@code{

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }
    private GetStudentDTO student;
    private bool isLoading = true;

    [Parameter]
    public int Id { get; set; }
    protected override async Task OnParametersSetAsync()
    { 
        isLoading = true;
        try
        {
            if (Id > 0)
            {
                student = await StudentService.GetStudentByIdAsync(Id);
            }
        }
        finally
        {
            isLoading = false;
        }
    }
     private void Close() => MudDialog.Close();
     private void BackToList()
    {
        NavigationManager.NavigateTo("/Students");
    }

}